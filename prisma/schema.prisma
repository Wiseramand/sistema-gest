generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  username     String?  @unique
  passwordHash String?
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  username         String?  @unique
  passwordHash     String?
  role             String   @default("ADMIN")
  responsibilities String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Student {
  id                String    @id @default(cuid())
  name              String
  email             String?   @unique
  username          String?   @unique
  passwordHash      String?
  phone             String?
  bi                String?
  address           String?
  company           String?
  role              String    @default("STUDENT")
  accessGeneratedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  clientType        String    @default("Particular")
  companyId         String?
  course            String?
  idDocument        String?
  nationality       String?
  photo             String?
  status            String    @default("Ativo")
  validity          String?
}

model Trainer {
  id                String    @id @default(cuid())
  name              String
  email             String?   @unique
  username          String?   @unique
  passwordHash      String?
  phone             String?
  role              String    @default("TRAINER")
  accessGeneratedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  address           String?
  idDocument        String?
  nationality       String?
  photo             String?
  specialty         String?
  status            String    @default("Ativo")
  students          Int       @default(0)
  validity          String?
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  duration    String?
  category    String?
  status      String   @default("ACTIVE")
  trainerId   String?
  trainerName String?
  startDate   String?
  endDate     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  materials   String   @default("[]")
  students    Int      @default(0)
}

model Classroom {
  id           String   @id @default(cuid())
  name         String
  capacity     Int?
  location     String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  availability String   @default("Disponível")
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  studentName String?
  courseId    String
  courseTitle String?
  status      String   @default("ACTIVE")
  enrolledAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inscription {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  course    String?
  message   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Matriculation {
  id            String   @id @default(cuid())
  studentId     String
  studentName   String?
  courseId      String?
  courseTitle   String?
  classroomId   String?
  status        String   @default("ACTIVE")
  startDate     String?
  endDate       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  amountDue     Int?     @default(0)
  classroom     String?
  course        String?
  duration      String?
  paymentStatus String?  @default("Pendente")
  schedule      String?
  trainer       String?
  trainerId     String?
}

model Certificate {
  id              String    @id @default(cuid())
  studentId       String
  studentName     String?
  courseTitle     String
  matriculationId String?
  status          String    @default("PENDENTE")
  generatedAt     DateTime  @default(now())
  validUntil      DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  trainingCenter  String    @default("Marítimo Training Center")
}

model Company {
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  nif           String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contactPerson String?
  logo          String?
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  role       String?
  action     String
  details    String?
  targetType String?
  targetId   String?
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Material {
  id             String   @id @default(cuid())
  name           String
  description    String?
  type           String?
  url            String?
  access         String   @default("ALL")
  uploadedBy     String?
  uploadedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isFolder       Boolean  @default(false)
  parentId       String?
  targetRole     String?
}

model ChatMessage {
  id          String   @id @default(cuid())
  senderId    String?
  senderName  String?
  senderRole  String?
  recipientId String?
  content     String
  channel     String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Feedback {
  id                  String   @id @default(cuid())
  studentId           String?
  studentName         String?
  courseId            String?
  courseTitle         String
  institutionFeedback String?
  trainerFeedback     String?
  courseFeedback      String?
  comments            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  courseId  String
  date      String
  trainerId String?
  records   String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, date])
}

model Notification {
  id        String   @id @default(cuid())
  studentId String
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Summary {
  id          String   @id @default(cuid())
  courseId    String
  courseTitle String?
  date        String
  content     String
  trainerId   String
  trainerName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, date])
}

model Grade {
  id           String   @id @default(cuid())
  studentId    String
  studentName  String?
  courseId     String
  courseTitle  String
  score        Float?
  observations String?
  trainerId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, courseId])
}
